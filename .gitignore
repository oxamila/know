# ---------------------------------------------------------------------------
# know — gitignore
# SECURITY: never commit dependencies, build output, env files, or the
# private _internal/ folder. See AGENTS.md ("Hard rules").
# ---------------------------------------------------------------------------

# dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
dist/
build/
out/
.next/
*.tsbuildinfo

# testing
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# turborepo cache
.turbo/

# environment & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.secrets*
credentials.json
service-account*.json

# private agent/system documentation — NEVER commit (see AGENTS.md)
_internal/

# vercel
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
bun-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
